{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "outDir": "dist/evm",
    "module": "commonjs",
    "rootDir": "."
  },
  "include": [
    "src/evm/**/*",
    "src/types/**/*",
    "src/utils/**/*",
    "typechain-types/**/*"
  ],
  "exclude": ["node_modules", "dist", "src/solana", "src/unified"]
}
